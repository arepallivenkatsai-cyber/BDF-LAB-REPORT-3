# ============================================================================
# Force sqlite3 to compile from source using node-gyp.
# sqlite3@6.0.1 uses `prebuild-install` which downloads prebuilt binaries.
# The prebuilt binaries require GLIBC_2.38 which Render's Linux env lacks.
#
# Setting build_from_source=true instructs prebuild-install to skip the
# prebuilt binary download and compile the native module from source instead,
# using the GLIBC version available in the actual deployment environment.
# ============================================================================
build_from_source=true
